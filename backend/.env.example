NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE=7d

# Database
MONGO_URI=mongodb://mongo:27017/parental_control

# CORS
CLIENT_URLS=http://localhost:3000,http://localhost:3001,exp://localhost:8081

# Socket.io
SOCKET_IO_DEBUG=true

# ============================================
# LOCAL WINDOWS PC INSTALLATION
# ============================================
# Set to 'local' for Windows PC installation
DB_TYPE=mongodb
DB_LOCAL_PATH=/path/to/data/control.db

# Local server settings
LOCAL_SERVER_PORT=3001
LOCAL_SERVER_HOST=0.0.0.0

# Windows service configuration
WINDOWS_SERVICE_NAME=TheRealParentalControl
WINDOWS_SERVICE_DISPLAY_NAME=The Real Parental Control
