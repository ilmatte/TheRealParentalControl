{
  "name": "@ParentalControl/client-windows",
  "version": "1.0.0",
  "description": "Windows client for parental control",
  "main": "src/main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "dev": "concurrently \"cross-env BROWSER=none npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run react-build && electron-builder",
    "start": "electron .",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.3.0",
    "socket.io-client": "^4.5.4",
    "uuid": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^23.6.0",
    "concurrently": "^7.5.0",
    "cross-env": "^7.0.3",
    "wait-on": "^6.0.1",
    "eslint": "^8.40.0",
    "prettier": "^2.8.8"
  },
  "homepage": "./",
  "build": {
    "appId": "com.parentalcontrol.windows",
    "productName": "Parental Control Child",
    "files": [
      "src/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
