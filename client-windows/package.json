{
  "name": "@ParentalControl/client-windows",
  "version": "1.0.0",
  "description": "Windows client for parental control",
  "main": "src/main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "dev": "concurrently \"cross-env BROWSER=none npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run react-build && node -e \"const fs = require('fs'); fs.copyFileSync('src/main.js', 'build/electron.js')\" && electron-builder --win --x64",
    "start": "electron .",
    "service-run": "node service.js",
    "service-install": "node service-install.js install",
    "service-uninstall": "node service-install.js uninstall",
    "install:system": "node service-install.js install --system",
    "uninstall:system": "node service-install.js uninstall --system",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.3.0",
    "electron-is-dev": "^2.0.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.5.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^7.5.0",
    "cross-env": "^7.0.3",
    "electron": "22.3.27",
    "electron-builder": "^26.8.1",
    "eslint": "^8.40.0",
    "prettier": "^2.8.8",
    "wait-on": "^6.0.1"
  },
  "build": {
    "appId": "com.parentalcontrol.windows",
    "productName": "Parental Control Child",
    "files": [
      "src/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "assets/installer.nsh"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
